# DSNTP NTP gateway chrony example (M5)
# Red line: ONLY local refclock from time-shim — NO external NTP servers.

# Feed from dsntp-time-shim SOCK (path must match shim -o)
refclock SOCK /var/run/chrony.dsntp.sock poll 2 refid DSYN

# Allow LAN clients (adjust to site)
allow 10.0.0.0/8
allow 192.168.0.0/16

# Prefer slew for small offsets; local stratum for clients
local stratum 8
makestep 1.0 3

# DO NOT uncomment external sources:
# server pool.ntp.org iburst
# server time.nist.gov
