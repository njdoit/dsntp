[Unit]
Description=DSNTP NTP time-shim (feeds chrony from Agent UDS)
After=dsntp-agent.service
Requires=dsntp-agent.service
Before=chronyd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/dsntp-time-shim -s /var/run/time-agent.sock -o /var/run/chrony.dsntp.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
